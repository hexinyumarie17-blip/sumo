<?xml version="1.0" encoding="UTF-8"?>
<!-- Channelised four-way urban intersection. East-west is the wider main arterial. -->
<edges>
    <!-- Four lanes per north-south direction: right turn, two through lanes, left turn. -->
    <edge id="N_in" from="north" to="J0" numLanes="4" speed="16.67" priority="8"/>
    <edge id="N_out" from="J0" to="north" numLanes="4" speed="16.67" priority="8"/>
    <edge id="S_in" from="south" to="J0" numLanes="4" speed="16.67" priority="8"/>
    <edge id="S_out" from="J0" to="south" numLanes="4" speed="16.67" priority="8"/>
    <!-- Five lanes per east-west direction: right turn, three through lanes, left turn. -->
    <edge id="E_in" from="east" to="J0" numLanes="5" speed="16.67" priority="10"/>
    <edge id="E_out" from="J0" to="east" numLanes="5" speed="16.67" priority="10"/>
    <edge id="W_in" from="west" to="J0" numLanes="5" speed="16.67" priority="10"/>
    <edge id="W_out" from="J0" to="west" numLanes="5" speed="16.67" priority="10"/>
</edges>
